# MoodPaper 后端环境变量配置

# API 密钥（从父目录的 .env 继承）
# OPENAI_API_KEY=your_openai_key_here

# 图像生成 API（按优先级排序）
# 1. 通义万相（推荐）- 便宜且有免费额度
# 申请地址: https://bailian.console.aliyun.com
TONGYI_API_KEY=sk-xxx

# 2. Stability AI（备选）
# STABILITY_API_KEY=sk-xxx

# 3. Replicate（备选）
# REPLICATE_API_TOKEN=r8_xxx

# 服务器配置
HOST=0.0.0.0
PORT=8000
RELOAD=True

# 前端地址（CORS 配置）
FRONTEND_URL=http://localhost:5173

# 日志级别
LOG_LEVEL=info
