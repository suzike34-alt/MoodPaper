# ============================================
# MoodPaper Git 忽略文件配置
# ============================================
# 这个文件告诉 Git 哪些文件不应该被上传到 GitHub
# 主要用于保护敏感信息（如 API 密钥）和忽略临时/生成的文件
# ============================================

# ========== 敏感信息 ==========
# .env 文件包含 API 密钥，绝对不能上传！
.env
.env.local
.env.*.local

# ========== 生成的文件（不需要上传）==========
# 生成的图片文件夹（会占用大量空间）
output/

# 缓存数据（每个人本地不同）
cache/

# ========== Python 相关 ==========
# __pycache__ 是 Python 自动生成的缓存文件夹
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境文件夹（不同的电脑可能使用不同名称）
venv/
env/
ENV/
.venv/

# ========== Node.js / React 相关 ==========
# node_modules 包含所有依赖包，非常大（通过 npm install 安装）
node_modules/

# 前端构建产物（通过 npm run build 生成）
dist/
build/

# 前端日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ========== IDE 配置文件 ==========
# VS Code 配置文件夹
.vscode/

# PyCharm 配置文件夹
.idea/

# ========== 操作系统相关 ==========
# macOS 系统文件
.DS_Store

# Windows 系统文件
Thumbs.db
desktop.ini

# ========== 其他临时文件 ==========
*.log
*.tmp
*.swp
*.swo
*~

# ========== 备份文件 ==========
*.bak
*.backup
